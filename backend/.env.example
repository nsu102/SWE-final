# Docker 로컬 DB 전용 값입니다. 외부에 노출하지 마세요.
POSTGRES_DB=fashion
POSTGRES_USER=fashion
POSTGRES_PASSWORD=fashion
POSTGRES_PORT=5432
DATABASE_URL=postgresql://fashion:fashion@localhost:5432/fashion
AUTO_MIGRATE=true
LOCAL_STORAGE_ROOT=storage
FASHION_CLIP_MODEL=yainage90/fashion-image-feature-extractor
HUMAN_PARSER_MODEL=fashn-ai/fashn-human-parser
MAX_UPLOAD_MB=10
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# 로컬에서는 access key를 사용할 수 있습니다. EC2에서는 IAM Role을 권장합니다.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

AWS_REGION=ap-northeast-2
AWS_BUCKET_NAME=software2026
# MinIO/LocalStack 등 S3 호환 저장소를 쓸 때만 설정합니다.
S3_ENDPOINT_URL=

# 비밀번호 재설정 메일. SMTP_HOST가 비어 있으면 재설정 링크를 백엔드 로그에 출력합니다(로컬 개발용).
FRONTEND_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=LookFind <no-reply@lookfind.local>

# 카카오 로그인 (Kakao Developers REST API 키). Redirect URI: {FRONTEND_URL}/api/auth/kakao/callback
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
# 비우면 {FRONTEND_URL}/api/auth/kakao/callback
KAKAO_REDIRECT_URI=

# JWT 서명 키 (32자 이상, 운영 필수). 생성: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# 쿠키 Secure 플래그. 비우면 FRONTEND_URL이 https일 때 true
COOKIE_SECURE=
