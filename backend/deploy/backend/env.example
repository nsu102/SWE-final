DATABASE_URL=postgresql://fashion_app:URL_ENCODED_PASSWORD@YOUR_RDS_ENDPOINT:5432/fashion?sslmode=verify-full&sslrootcert=/app/certs/global-bundle.pem
AUTO_MIGRATE=false
AWS_REGION=ap-northeast-2
AWS_BUCKET_NAME=software2026
LOCAL_STORAGE_ROOT=/app/storage
CORS_ORIGINS=https://YOUR_FRONTEND_DOMAIN
MAX_UPLOAD_MB=10
FASHION_CLIP_MODEL=yainage90/fashion-image-feature-extractor
HUMAN_PARSER_MODEL=fashn-ai/fashn-human-parser
OMP_NUM_THREADS=2
TOKENIZERS_PARALLELISM=false

# 비밀번호 재설정 메일. SMTP_HOST가 비어 있으면 재설정 링크를 백엔드 로그에 출력합니다(로컬 개발용).
FRONTEND_URL=https://YOUR_FRONTEND_DOMAIN
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=LookFind <no-reply@lookfind.local>

# 카카오 로그인 (Kakao Developers REST API 키). Redirect URI: {FRONTEND_URL}/api/auth/kakao/callback
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
# 비우면 {FRONTEND_URL}/api/auth/kakao/callback
KAKAO_REDIRECT_URI=
